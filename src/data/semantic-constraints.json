{
  "schema_version": "axiom-demo-semantics/1.0",
  "principles": [
    "Use local state spaces, not a global world state.",
    "A payoff-state implication f_A <= f_B yields the expectation-price inequality P(A) <= P(B).",
    "Do not infer multiplicative price relationships from conjunction payoff identities.",
    "Exact edges are deterministic properties of claims/payoffs, not semantic-similarity scores.",
    "Different resolution windows can break apparent equivalence."
  ],
  "state_spaces": [
    {
      "state_space_id": "sts_fomc_path_oct_dec_2026",
      "family_id": "fam_fomc_path_oct_dec_2026",
