        "is_cut": "bucket in ['CUT_25','CUT_50_PLUS']",
        "is_hold": "bucket == 'HOLD'"
      },
      "enumeration": "Cartesian product of non-fixed variables; deterministic.",
      "payoffs": {
        "ins_oct_cut_50p": "october_change_bucket == 'CUT_50_PLUS'",
        "ins_oct_cut_25": "october_change_bucket == 'CUT_25'",
        "ins_oct_hold": "october_change_bucket == 'HOLD'",
        "ins_oct_hike_25": "october_change_bucket == 'HIKE_25'",
        "ins_oct_hike_50p": "october_change_bucket == 'HIKE_50_PLUS'",
        "ins_dec_cut_50p": "december_change_bucket == 'CUT_50_PLUS'",
        "ins_dec_cut_25": "december_change_bucket == 'CUT_25'",
        "ins_dec_hold": "december_change_bucket == 'HOLD'",
        "ins_dec_hike_25": "december_change_bucket == 'HIKE_25'",
        "ins_dec_hike_50p": "december_change_bucket == 'HIKE_50_PLUS'",
        "ins_path_hhh": "is_hike(october_change_bucket) && is_hike(december_change_bucket)",
        "ins_path_hph": "is_hold(october_change_bucket) && is_hike(december_change_bucket)",
        "ins_path_hhp": "is_hike(october_change_bucket) && is_hold(december_change_bucket)",
        "ins_path_hpp": "is_hold(october_change_bucket) && is_hold(december_change_bucket)",
        "ins_path_other": "is_cut(october_change_bucket) || is_cut(december_change_bucket)",
        "ins_another_hike": "is_hike(october_change_bucket) || is_hike(december_change_bucket) || emergency_hike_sep17_through_dec_meeting"
      }
    },
    {
      "state_space_id": "sts_hike_count_2026",
      "family_id": "fam_fed_hike_count_2026",
